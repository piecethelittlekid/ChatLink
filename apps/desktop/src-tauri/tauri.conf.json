{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ChatLink",
  "version": "0.1.0",
  "identifier": "com.chatlink.desktop",
  "build": {
    "beforeDevCommand": "npm.cmd run build:mobile --prefix ../../",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm.cmd run build:mobile --prefix ../../",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ChatLink",
        "width": 1120,
        "height": 760,
        "minWidth": 820,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "category": "Utility",
    "shortDescription": "Private LAN chat between Windows and iPhone",
    "resources": {
      "../../mobile-web/dist/": "mobile-web/"
    }
  }
}
